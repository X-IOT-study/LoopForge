# Local-only edition sample: one password account, loopback-only listening, and
# no cloud runners, tapd sync, notification delivery, or platform accounts.
# Copy to .env first:  cp .env.local.example .env
#
# One supported way to run it: the platform as a host process (loopback by
# default). MySQL can still come from Compose:
#   docker compose up -d mysql
#   go build -o .local/bin/agentflow ./cmd/agentflow
#   ./.local/bin/agentflow -addr 127.0.0.1:8090 -workspaces .data/workspaces
# Do NOT run the platform as the Compose service: compose injects
# AGENTFLOW_LOCAL_SANDBOX=docker for it, and in local mode the docker driver
# fails every node with local_sandbox_unsupported (a container has no host CLI
# login state either). Compose is only the database here.
LOOPFORGE_IMAGE=
AGENTFLOW_HTTP_PORT=8090
AGENTFLOW_MYSQL_DSN=loopforge:REPLACE_ME@tcp(127.0.0.1:33315)/loopforge
# Host process: leave empty on purpose. The first start generates
# <AGENTFLOW_DATA_DIR>/local/session.key with 0600 and reuses it afterwards, so
# browser sessions survive restarts.
# A Compose-started service (platform mode) requires a value and refuses to
# start without one; set it only when you are not running local mode:
#   AGENTFLOW_SESSION_SECRET=$(openssl rand -hex 32)
AGENTFLOW_SESSION_SECRET=
AGENTFLOW_AUTH_REQUIRED=true
LOOPFORGE_DB_PASSWORD=REPLACE_ME
LOOPFORGE_DB_ROOT_PASSWORD=REPLACE_ME
LOOPFORGE_MYSQL_PORT=33315
# Loopback only. Change this together with AGENTFLOW_LOCAL_ALLOW_REMOTE=1 if you
# want to reach the instance from another device on your network.
LOOPFORGE_BIND=127.0.0.1
AGENTFLOW_LOCAL_MODE=1
# Escape hatch for the host process only: allow a non-loopback listen address
# (e.g. -addr 0.0.0.0:8090). It does not make the Compose container a supported
# local-mode runtime; see docs/local-mode.md.
AGENTFLOW_LOCAL_ALLOW_REMOTE=
# Where run data lives. The local-mode session key defaults to the parent of the
# workspace root: with -workspaces .data/workspaces it lands in
# .data/data/local/session.key. Set AGENTFLOW_DATA_DIR to pin it, e.g. .data
# puts the key at .data/local/session.key.
LOOPFORGE_DATA_DIR=.data
